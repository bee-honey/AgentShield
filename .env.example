# Copy to .env for local development. Never commit .env.
# These defaults are for the local Docker Compose stack only.

POSTGRES_PASSWORD=postgres-dev-only
AGENTSHIELD_OWNER_PASSWORD=owner-dev-only
AGENTSHIELD_APP_PASSWORD=app-dev-only

KEYCLOAK_ADMIN_PASSWORD=admin-dev-only

# Model provider keys (Phase 1+)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Host port for the gateway (8080 is often taken)
GATEWAY_PORT=8090
