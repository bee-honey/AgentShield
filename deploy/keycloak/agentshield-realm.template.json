{
  "realm": "agentshield",
  "displayName": "AgentShield",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "support-agent",
      "name": "Support Agent",
      "description": "Consumer agent: investigates customer tickets and drafts responses",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "clientAuthenticatorType": "client-jwt",
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "attributes": {
        "jwt.credential.certificate": "__CERT_SUPPORT_AGENT__",
        "token.endpoint.auth.signing.alg": "RS256",
        "access.token.lifespan": "300",
        "use.refresh.tokens": "false",
        "client_credentials.use_refresh_token": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "agentshield-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "agent_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "agent_id",
            "claim.value": "support-agent",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "agent_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "agent_type",
            "claim.value": "support",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "security-analyst-agent",
      "name": "Security Analyst Agent",
      "description": "Internal agent: investigates security events and proposes remediation (propose-only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "clientAuthenticatorType": "client-jwt",
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "attributes": {
        "jwt.credential.certificate": "__CERT_SECURITY_ANALYST_AGENT__",
        "token.endpoint.auth.signing.alg": "RS256",
        "access.token.lifespan": "300",
        "use.refresh.tokens": "false",
        "client_credentials.use_refresh_token": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "agentshield-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "agent_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "agent_id",
            "claim.value": "security-analyst-agent",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "agent_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "agent_type",
            "claim.value": "security_analyst",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
